{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lithophane Studio",
  "version": "1.0.1",
  "identifier": "com.lithophanestudio.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lithophane Studio",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0b0e14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Fast, watertight 3D lithophane generator",
    "longDescription": "Design and export watertight 3D-printable flat, curved, and multi-panel lithophanes with real-time physical backlit simulation, restorable projects, and STL/3MF export.",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
